Screen {
    background: $background;
    color: $foreground;
}

/* App shell container */
.app-shell {
    width: 100%;
    height: 100%;
    padding: 0 1;
}

/* --- Top Navigation Bar --- */
TopNavBar.top-navbar-container {
    height: 3;
    width: 100%;
    background: $surface;
    border-bottom: solid $panel;
    padding: 0 1;
    align: left middle;
    margin-bottom: 1;
}

.nav-brand-title {
    color: $primary;
    text-style: bold;
    width: 12;
    align: left middle;
}

.nav-btn-group {
    width: 1fr;
    align: right middle;
}

.nav-tab-btn {
    min-width: 9;
    height: 1;
    padding: 0 1;
    margin: 0 1;
    background: transparent;
    border: none;
    color: $text-muted;
}

.nav-tab-btn:hover {
    color: $text;
    background: $boost;
}

.nav-tab-active {
    background: $accent;
    color: $text-primary;
    text-style: bold;
}

/* --- Card containers --- */
.card-container {
    border: solid $secondary-darken-2;
    border-title-color: $text-muted;
    background: $surface;
    padding: 1 1;
}

.card-container:focus-within {
    border: double $accent;
    border-title-color: $accent;
    background: $surface-lighten-1;
}

.card-container.with-title {
    padding-top: 0;
}

.card-title {
    text-style: bold;
    color: $text-primary;
    background: $surface;
    padding: 0 1;
    margin: -1 -1 0 -1;
    width: 100%;
    box-sizing: border-box;
}

.card-tag {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

.subtext-dim {
    color: $text-disabled;
}

/* Improve gap visibility in activity list */
.activity-gap-row {
    background: $surface-darken-1;
    opacity: 0.8;
}

.activity-gap-row .activity-name,
.activity-gap-row .activity-duration {
    color: $text-muted;
    text-style: italic;
}

/* --- Main Homepage Layout --- */
.main-content-layout {
    width: 100%;
    height: 1fr;
    margin-bottom: 1;
}

.main-left-column {
    width: 2fr;
    height: 100%;
    margin-right: 1;
}

.main-right-column {
    width: 1fr;
    height: 100%;
}

/* --- Timer Card --- */
TimerCard.timer-box {
    height: 18;
    margin-bottom: 1;
}

.timer-display-row {
    height: 6;
    width: 100%;
    align: center middle;
}

.timer-digital-display {
    color: $text;
    text-style: bold;
    width: auto;
    text-align: center;
    content-align: center middle;
}

.timer-digital-display.timer-active {
    color: $accent;
}

.timer-sub-row {
    height: 1;
    width: 100%;
    align: left middle;
}

#timer-next-phase {
    width: 1fr;
    color: $text-muted;
    text-align: left;
}

#cycle-badge {
    color: $text-muted;
    text-style: bold;
    width: auto;
    text-align: right;
}

#timer-progress {
    width: 100%;
    height: 2;
    margin-top: 1;
    margin-bottom: 1;
    background: $panel-lighten-1;
}

.timer-controls-row {
    height: 3;
    width: 100%;
    align: left middle;
}

.timer-buttons {
    width: auto;
    height: 3;
    align: left middle;
}

.timer-text-btn {
    min-width: 12;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: $boost;
    border: round $secondary-darken-1;
    color: $text;
    content-align: center middle;
}

.timer-text-btn:hover {
    background: $panel;
    border: round $primary;
}

.timer-text-btn:focus {
    border: round $accent;
}

.timer-activity-info {
    width: 1fr;
    height: 3;
    align: right middle;
    text-align: right;
}

#timer-activity-name {
    color: $primary;
    text-style: bold;
    text-align: right;
}

/* --- Bottom Row of Homepage --- */
.main-bottom-row {
    height: 1fr;
    width: 100%;
}

GoalsCard.goals-box {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

StatsChartCard.stats-chart-box {
    width: 1fr;
    height: 100%;
}

#goals-entries-container {
    height: 1fr;
    scrollbar-size: 1 1;
}

.goal-entry {
    height: auto;
    margin-bottom: 1;
}

.goal-header-row {
    height: 1;
    width: 100%;
    align: left middle;
}

.goal-sublabel {
    color: $text-disabled;
    width: auto;
}

.goal-sublabel-active {
    color: $primary;
    text-style: bold;
}

.goal-badge-completed {
    color: $success;
    text-style: bold;
    margin-left: 2;
    width: auto;
}

.goal-countdown {
    color: $text;
    text-style: bold;
    height: 1;
}

.goal-bar-row {
    height: 2;
    width: 100%;
    align: left middle;
}

.goal-thick-pb {
    width: 1fr;
    height: 2;
    margin-right: 1;
}

.goal-diff {
    color: $text-muted;
    width: 8;
    text-align: right;
}

.stats-nav-header-row {
    height: 1;
    width: 100%;
    align: center middle;
    margin-bottom: 1;
}

.btn-chart-nav {
    min-width: 3;
    width: 3;
    height: 1;
    padding: 0;
    margin: 0 1;
    background: transparent;
    border: none;
    color: $text-muted;
}

.btn-chart-nav:hover {
    color: $accent;
    background: $boost;
}

.date-range-header {
    text-align: center;
    color: $text-muted;
    height: 1;
    width: auto;
}

.ascii-chart {
    color: $accent;
    text-align: center;
    height: 1fr;
}

/* --- Right Column: Streak & Activity List --- */
StreakCard.streak-box {
    height: 6;
    margin-bottom: 1;
}

.streak-days-row {
    height: 3;
    align: center middle;
}

.streak-col {
    width: 4;
    align: center middle;
    margin: 0 2;
}

.streak-icon-box {
    width: 3;
    height: 1;
    text-align: center;
}

.status-done {
    color: $success;
}

.status-miss {
    color: $error;
}

.status-pending {
    color: $text-disabled;
}

.streak-day-label {
    color: $text-muted;
    text-align: center;
}

ActivityListCard.activity-list-box {
    height: 1fr;
}

.date-pill-badge {
    text-align: center;
    background: $boost;
    color: $text;
    padding: 0 1;
    margin: 1 1 0 1;
    width: auto;
    text-style: bold;
}

.activity-items-list {
    height: 1fr;
    scrollbar-size: 1 1;
}

.activity-row {
    height: auto;
    min-height: 1;
    align: left top;
}

.activity-time {
    color: $text-muted;
    width: 6;
}

.activity-bar {
    width: 2;
    margin-right: 1;
}

.bar-green { color: $success; }
.bar-blue { color: $primary; }
.bar-yellow { color: $warning; }
.bar-pink { color: $accent; }
.bar-purple { color: $primary-lighten-2; }
.bar-cyan { color: $secondary; }
.bar-red { color: $error; }
.bar-gray { color: $text-muted; }

.activity-name {
    color: $text;
    width: 1fr;
}

.activity-duration {
    color: $text-muted;
    width: auto;
    text-align: right;
}

.activity-break-row,
.activity-break-row .activity-name,
.activity-break-row .activity-duration,
.activity-gap-row,
.activity-gap-row .activity-name,
.activity-gap-row .activity-duration {
    color: $text-disabled;
}

.footer-bindings {
    width: 100%;
    align: left middle;
}

.footer-item {
    color: $accent;
    margin-right: 2;
}

/* --- Stats Screen --- */
StatsHeader.stats-header-bar {
    height: 5;
    background: $surface;
    border: round $secondary-darken-2;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

.stats-header-time-box {
    width: 1fr;
}

.stats-big-time {
    color: $text;
    text-style: bold;
}

.stats-nav-tabs {
    width: auto;
    align: center middle;
}

.tab-btn {
    min-width: 10;
    height: 3;
    margin: 0 1;
    background: $boost;
    border: none;
    color: $text-muted;
}

.tab-active {
    background: $accent;
    color: $text-primary;
    text-style: bold;
}

.filter-btn {
    min-width: 8;
    border: round $panel;
}

.focus-break-box {
    width: 28;
    align: right middle;
}

.ratio-bar-row {
    height: 1;
    align: right middle;
}

.ratio-pct-label {
    color: $text-muted;
    width: 4;
}

.ratio-progress {
    width: 16;
    height: 1;
    margin: 0 1;
}

.ratio-progress Bar {
    width: 1fr;
}

.ratio-progress > .bar--bar {
    color: $accent;
    background: $boost;
}

.stats-body-layout {
    height: 1fr;
    width: 100%;
}

.stats-left-area {
    width: 2fr;
    height: 100%;
    margin-right: 1;
}

.stats-right-area {
    width: 1fr;
    height: 100%;
}

.stats-content-area {
    border: round $secondary-darken-2;
    background: $surface;
    padding: 1;
    width: 100%;
    height: 100%;
}

.today-stats-grid {
    grid-size: 2 2;
    grid-gutter: 1;
    height: 1fr;
}

.card-sub-box {
    border: round $panel;
    padding: 0 1;
    align: center middle;
}

.chart-sub-title {
    color: $text-muted;
    text-align: center;
}

.week-top-row {
    height: 1fr;
    margin-bottom: 1;
}

.week-bottom-row {
    height: 10;
}

.week-bar-col {
    width: 1fr;
    margin-right: 1;
}

.week-history-col {
    width: 2fr;
}

.avg-focus-col {
    width: 1fr;
    margin-right: 1;
}

.legend-box {
    width: 18;
    height: 100%;
    border: round $panel;
}

.legend-title {
    color: $text-muted;
}

.legend-sleep { color: $success; }
.legend-coding { color: $primary; }
.legend-studying { color: $warning; }

.month-bottom-row,
.year-bottom-row {
    height: 10;
    margin-top: 1;
}

.cal-matrix-box {
    width: 2fr;
    margin: 0 1;
}

.cal-header {
    color: $text-muted;
    text-align: center;
}

.cal-body {
    color: $text;
    text-align: center;
}

/* --- Modal Break Overlay --- */
.break-modal-container {
    background: rgba(0, 0, 0, 0.9);
    width: 100%;
    height: 100%;
}

.break-modal-box {
    border: double $accent;
    background: $surface;
    padding: 2 4;
    align: center middle;
    width: 60;
    height: 18;
}

.break-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#break-digits {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

.break-subtitle {
    color: $text-muted;
    text-align: center;
}

/* --- Zen Mode Expansion --- */
.zen-active TopNavBar,
.zen-active .main-bottom-row,
.zen-active .main-right-column {
    display: none;
}

.zen-active .main-content-layout {
    height: 100%;
    width: 100%;
    margin: 0;
}

.zen-active .main-left-column {
    width: 100%;
    height: 100%;
    margin: 0;
}

TimerCard.zen-mode {
    width: 100%;
    height: 100%;
    border: double $accent;
    align: center middle;
    padding: 2 4;
}

TimerCard.zen-mode .timer-display-row {
    height: 7;
    margin-top: 1;
    margin-bottom: 1;
}

TimerCard.zen-mode #timer-progress {
    height: 3;
    margin-top: 2;
    margin-bottom: 2;
}

/* ============================================================
   Settings Screen
   ============================================================ */

.settings-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-size: 1 1;
}

.settings-center-wrapper {
    width: 100%;
    height: auto;
    align: center top;
}

.settings-container {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

/* Small semantic groups inside the cards */
.settings-group {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.settings-section-title {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
    text-style: bold;
}

/* Generic rows retained for General / Overlay settings */
.settings-row {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.settings-label {
    width: 18;
    height: 3;
    text-style: bold;
    color: $text;
    content-align: left middle;
}

.settings-input {
    width: 1fr;
    height: 3;
    background: $panel;
}

.settings-select {
    width: 1fr;
    height: 3;
}

/* Activities ------------------------------------------------- */

.activity-selector-row,
.activity-create-row {
    width: 100%;
    height: 3;
    align: left middle;
}

.activity-selector-row .activity-select {
    width: 1fr;
}

.activity-selector-row .color-input {
    width: 12;
    margin-left: 1;
}

.color-preview {
    width: 6;
    height: 3;
    content-align: center middle;
    text-style: bold;
    background: $panel;
    border: round $panel;
    margin-left: 1;
}

.activity-selector-row Button {
    height: 3;
    margin-left: 1;
}

.activity-create-row Button {
    height: 3;
    margin-left: 1;
}

.goals-group {
    margin-top: 1;
}

.goals-row {
    width: 100%;
    height: 4;
    align: left top;
}

.goal-field {
    width: 1fr;
    height: 4;
    margin-right: 2;
}

.goal-field:last-child {
    margin-right: 0;
}

.goal-field Label,
.preset-field Label {
    width: 100%;
    height: 1;
    color: $text-muted;
}

.goal-field Input {
    width: 100%;
    height: 3;
}

/* Presets ---------------------------------------------------- */

.preset-selector-row {
    width: 100%;
    height: 3;
    align: left middle;
}

.preset-selector-row .settings-select {
    width: 1fr;
}

.preset-selector-row Button {
    height: 3;
    margin-left: 1;
}

.preset-name-row {
    width: 100%;
    height: 3;
}

.preset-values-row {
    width: 100%;
    height: 4;
    align: left top;
}

.preset-field {
    width: 1fr;
    height: 4;
    margin-right: 2;
}

.preset-field:last-child {
    margin-right: 0;
}

.preset-field Input {
    width: 100%;
    height: 3;
}

.timer-values-group {
    margin-top: 1;
}

/* Action buttons --------------------------------------------- */

.settings-btn-row {
    width: 100%;
    height: 3;
    margin-top: 1;
    align: right middle;
}

.settings-btn-row Button {
    margin-left: 1;
}

.settings-status {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $success;
    text-align: center;
}

/* Activity color / destructive actions ---------------------- */

.btn-danger {
    background: $error-darken-1;
    color: $text;
    border: round $error;
}

.btn-danger:hover {
    background: $error;
    color: $text;
    border: round $error-lighten-1;
}

.settings-container Button {
    min-width: 10;
}

/* Keep compact controls compact */
.settings-container .color-input,
.settings-container .color-preview {
    width: auto;
}
