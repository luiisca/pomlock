Screen {
    background: $background;
    color: $foreground;
}

/* App shell container */
.app-shell {
    width: 100%;
    height: 100%;
    padding: 0 1;
}

/* --- Top Navigation Bar --- */
TopNavBar.top-navbar-container {
    height: 3;
    width: 100%;
    background: $surface;
    border-bottom: solid $panel;
    padding: 0 1;
    align: left middle;
    margin-bottom: 1;
}

.nav-brand-title {
    color: $primary;
    text-style: bold;
    width: 12;
    align: left middle;
}

.nav-btn-group {
    width: 1fr;
    align: right middle;
}

.nav-tab-btn {
    min-width: 9;
    height: 1;
    padding: 0 1;
    margin: 0 1;
    background: transparent;
    border: none;
    color: $text-muted;
}

.nav-tab-btn:hover {
    color: $text;
    background: $boost;
}

.nav-tab-active {
    background: $accent;
    color: $text-primary;
    text-style: bold;
}

/* Card container base using theme colors */
.card-container {
    border: solid $secondary-darken-2;
    border-title-color: $text-muted;
    background: $surface;
    padding: 0 1;
}

.card-container:focus-within {
    border: double $accent;  /* Double border for thicker appearance when focused */
    border-title-color: $accent;
    background: $surface-lighten-1;  /* Subtle background change */
}

/* Title integration - reduce top padding for cards with integrated titles */
.card-container.with-title {
    padding-top: 0;  /* Title will touch the top border */
}

/* Title styling for integrated appearance */
.card-title {
    text-style: bold;
    color: $text-primary;
    background: $surface;  /* Match card background */
    padding: 0 1;  /* Match horizontal padding */
    margin: -1 -1 0 -1;  /* Pull up to overlap border */
    width: 100%;
    box-sizing: border-box;
}

/* Improve gap visibility in activity list */
.activity-gap-row {
    background: $surface-darken-1;  /* Slightly darker background */
    opacity: 0.8;  /* Slightly transparent */
}

.activity-gap-row .activity-name,
.activity-gap-row .activity-duration {
    color: $text-muted;  /* Keep muted text but enhance with background */
    text-style: italic;  /* Italic to distinguish */
}

.card-tag {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

.subtext-dim {
    color: $text-disabled;
}

/* Main Homepage Layout */
.main-content-layout {
    width: 100%;
    height: 1fr;
    margin-bottom: 1;
}

.main-left-column {
    width: 2fr;
    height: 100%;
    margin-right: 1;
}

.main-right-column {
    width: 1fr;
    height: 100%;
}

/* --- Timer Card --- */
TimerCard.timer-box {
    height: 18;
    margin-bottom: 1;
}

.timer-display-row {
    height: 6;
    width: 100%;
    align: center middle;
}

.timer-digital-display {
    color: $text;
    text-style: bold;
    width: auto;
    text-align: center;
    content-align: center middle;
}

.timer-digital-display.timer-active {
    color: $accent;
}

.timer-sub-row {
    height: 1;
    width: 100%;
    align: left middle;
    margin-top: 0;
    margin-bottom: 0;
}

#timer-next-phase {
    width: 1fr;
    color: $text-muted;
    text-align: left;
}

#cycle-badge {
    color: $text-muted;
    text-style: bold;
    width: auto;
    text-align: right;
}

/* Thick block progress bar spanning the entire card */
#timer-progress {
    width: 100%;
    height: 2;
    margin-top: 1;
    margin-bottom: 1;
    background: $panel-lighten-1;
}

.timer-controls-row {
    height: 3;
    width: 100%;
    align: left middle;
}

.timer-buttons {
    width: auto;
    height: 3;
    align: left middle;
}

/* Text-based action buttons */
.timer-text-btn {
    min-width: 12;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: $boost;
    border: round $secondary-darken-1;
    color: $text;
    content-align: center middle;
}

.timer-text-btn:hover {
    background: $panel;
    border: round $primary;
}

.timer-text-btn:focus {
    border: round $accent;
}

.timer-activity-info {
    width: 1fr;
    height: 3;
    align: right middle;
    text-align: right;
}

#timer-activity-name {
    color: $primary;
    text-style: bold;
    text-align: right;
}

/* --- Bottom Row of Homepage --- */
.main-bottom-row {
    height: 1fr;
    width: 100%;
}

GoalsCard.goals-box {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

StatsChartCard.stats-chart-box {
    width: 1fr;
    height: 100%;
}

#goals-entries-container {
    height: 1fr;
    scrollbar-size: 1 1;
}


.goal-entry {
    height: auto;
    margin-bottom: 1;
}

.goal-header-row {
    height: 1;
    width: 100%;
    align: left middle;
}

.goal-sublabel {
    color: $text-disabled;
    width: auto;
}

.goal-sublabel-active {
    color: $primary;
    text-style: bold;
}

.goal-badge-completed {
    color: $success;
    text-style: bold;
    margin-left: 2;
    width: auto;
}

.goal-countdown {
    color: $text;
    text-style: bold;
    height: 1;
}

.goal-bar-row {
    height: 2;
    width: 100%;
    align: left middle;
    margin-top: 0;
    margin-bottom: 0;
}

.goal-thick-pb {
    width: 1fr;
    height: 2;
    margin: 0;
    margin-right: 1;
}

.goal-diff {
    color: $text-muted;
    width: 8;
    text-align: right;
}


.stats-nav-header-row {
    height: 1;
    width: 100%;
    align: center middle;
    margin-bottom: 1;
}

.btn-chart-nav {
    min-width: 3;
    width: 3;
    height: 1;
    padding: 0;
    margin: 0 1;
    background: transparent;
    border: none;
    color: $text-muted;
}

.btn-chart-nav:hover {
    color: $accent;
    background: $boost;
}

.date-range-header {
    text-align: center;
    color: $text-muted;
    height: 1;
    width: auto;
}

.ascii-chart {
    color: $accent;
    text-align: center;
    height: 1fr;
}

/* --- Right Column: Streak & Activity List --- */
StreakCard.streak-box {
    height: 6;
    margin-bottom: 1;
}

.streak-days-row {
    height: 3;
    align: center middle;
}

.streak-col {
    width: 4;
    align: center middle;
    margin: 0 1;
}

.streak-icon-box {
    width: 3;
    height: 1;
    text-align: center;
}

.status-done {
    color: $success;
}

.status-miss {
    color: $error;
}

.status-pending {
    color: $text-disabled;
}

.streak-day-label {
    color: $text-muted;
    text-align: center;
}

ActivityListCard.activity-list-box {
    height: 1fr;
}

.date-pill-badge {
    text-align: center;
    background: $boost;
    color: $text;
    padding: 0 1;
    margin: 1 1 0 1;
    width: auto;
    text-style: bold;
}

.activity-items-list {
    height: 1fr;
    scrollbar-size: 1 1;
}

.activity-row {
    height: auto;
    min-height: 1;
    align: left top;
    margin-bottom: 0;
}

.activity-time {
    color: $text-muted;
    width: 6;
}

.activity-bar {
    width: 2;
    margin-right: 1;
}

.bar-green {
    color: $success;
}

.bar-blue {
    color: $primary;
}

.bar-yellow {
    color: $warning;
}

.bar-pink {
    color: $accent;
}

.bar-purple {
    color: $primary-lighten-2;
}

.bar-cyan {
    color: $secondary;
}

.bar-red {
    color: $error;
}

.bar-gray {
    color: $text-muted;
}

.activity-name {
    color: $text;
    width: 1fr;
}

.activity-duration {
    color: $text-muted;
    width: auto;
    text-align: right;
}

.activity-break-row,
.activity-break-row .activity-name,
.activity-break-row .activity-duration,
.activity-gap-row,
.activity-gap-row .activity-name,
.activity-gap-row .activity-duration {
    color: $text-disabled;
}

/* --- Footer Bar --- */
FooterBar.footer-container {
    height: 1;
    width: 100%;
    background: $surface;
    padding: 0 1;
    align: left middle;
}

.footer-bindings {
    width: 100%;
    align: left middle;
}

.footer-item {
    color: $accent;
    margin-right: 2;
}

/* --- Stats Screen --- */
StatsHeader.stats-header-bar {
    height: 5;
    background: $surface;
    border: round $secondary-darken-2;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

.stats-header-time-box {
    width: 1fr;
}

.stats-big-time {
    color: $text;
    text-style: bold;
}

.stats-nav-tabs {
    width: auto;
    align: center middle;
}

.tab-btn {
    min-width: 10;
    height: 3;
    margin: 0 1;
    background: $boost;
    border: none;
    color: $text-muted;
}

.tab-active {
    background: $accent;
    color: $text-primary;
    text-style: bold;
}

.filter-btn {
    min-width: 8;
    border: round $panel;
}

.focus-break-box {
    width: 28;
    align: right middle;
}

.ratio-bar-row {
    height: 1;
    align: right middle;
}

.ratio-pct-label {
    color: $text-muted;
    width: 4;
}

.ratio-progress {
    width: 16;
    height: 1;
    margin: 0 1;
}

.ratio-progress Bar {
    width: 1fr;
}

.ratio-progress > .bar--bar {
    color: $accent;
    background: $boost;
}

/* Stats Content Layouts */
.stats-body-layout {
    height: 1fr;
    width: 100%;
}

.stats-left-area {
    width: 2fr;
    height: 100%;
    margin-right: 1;
}

.stats-right-area {
    width: 1fr;
    height: 100%;
}

.stats-content-area {
    border: round $secondary-darken-2;
    background: $surface;
    padding: 1;
    width: 100%;
    height: 100%;
}

.today-stats-grid {
    grid-size: 2 2;
    grid-gutter: 1;
    height: 1fr;
}

.card-sub-box {
    border: round $panel;
    padding: 0 1;
    align: center middle;
}

.chart-sub-title {
    color: $text-muted;
    text-align: center;
}

.week-top-row {
    height: 1fr;
    margin-bottom: 1;
}

.week-bottom-row {
    height: 10;
}

.week-bar-col {
    width: 1fr;
    margin-right: 1;
}

.week-history-col {
    width: 2fr;
}

.avg-focus-col {
    width: 1fr;
    margin-right: 1;
}

.legend-box {
    width: 18;
    height: 100%;
    border: round $panel;
}

.legend-title {
    color: $text-muted;
}

.legend-sleep {
    color: $success;
}

.legend-coding {
    color: $primary;
}

.legend-studying {
    color: $warning;
}

.month-bottom-row, .year-bottom-row {
    height: 10;
    margin-top: 1;
}

.cal-matrix-box {
    width: 2fr;
    margin: 0 1;
}

.cal-header {
    color: $text-muted;
    text-align: center;
}

.cal-body {
    color: $text;
    text-align: center;
}

/* Modal Break Overlay */
.break-modal-container {
    background: rgba(0, 0, 0, 0.9);
    width: 100%;
    height: 100%;
}

.break-modal-box {
    border: double $accent;
    background: $surface;
    padding: 2 4;
    align: center middle;
    width: 60;
    height: 18;
}

.break-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#break-digits {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

.break-subtitle {
    color: $text-muted;
    text-align: center;
}

/* Zen Mode Expansion */
.zen-active TopNavBar,
.zen-active FooterBar,
.zen-active .main-bottom-row,
.zen-active .main-right-column {
    display: none;
}

.zen-active .main-content-layout {
    height: 100%;
    width: 100%;
    margin: 0;
}

.zen-active .main-left-column {
    width: 100%;
    height: 100%;
    margin: 0;
}

TimerCard.zen-mode {
    width: 100%;
    height: 100%;
    border: double $accent;
    align: center middle;
    padding: 2 4;
}

TimerCard.zen-mode .timer-display-row {
    height: 7;
    margin-top: 1;
    margin-bottom: 1;
}

TimerCard.zen-mode #timer-progress {
    height: 3;
    margin-top: 2;
    margin-bottom: 2;
}

/* Settings Screen */
.settings-container {
    width: 80;
    height: auto;
    margin: 2 4;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

.settings-row {
    height: auto;
    margin-bottom: 1;
    align-vertical: middle;
}

.settings-label {
    width: 18;
    text-style: bold;
    color: $text;
}

.settings-input {
    width: 1fr;
    background: $panel;
}

.settings-select {
    width: 1fr;
}

.settings-btn-row {
    height: auto;
    margin-top: 1;
    align: right middle;
}

.settings-btn-row Button {
    margin-left: 2;
}

.settings-status {
    height: 1;
    margin-top: 1;
    color: $success;
    text-align: center;
}
